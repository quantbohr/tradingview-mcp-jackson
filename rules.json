  "conditions": [
    {
      "id": "lnl-armed-breakout",
      "description": "LnL Armed + Breakout Up signals — primary entry trigger. HIGHEST WEIGHT.",
      "indicator": "Locked and Loaded + LossMin v2",
      "fields": [
        "Armed signal",
        "Breakout up"
      ],
      "weight": 3.0
    },
    {
      "id": "3dxe-bull-signals",
      "description": "3DXE Bull Takeoff or Cross Up — trend ignition. HIGH WEIGHT.",
      "indicator": "3DXE ULTIMATE b015",
      "fields": [
        "Bull Takeoff",
        "Cross Up",
        "Bull Score HIGH"
      ],
      "weight": 2.5
    },
    {
      "id": "cttv-momentum",
      "description": "CTTV TTM momentum positive + Bull Volume+Price Confirm. MEDIUM WEIGHT.",
      "indicator": "CTTV TTM v6",
      "fields": [
        "Momentum Histogram",
        "Bull Volume+Price Confirm",
        "Expansion Squeeze"
      ],
      "weight": 1.5
    },
    {
      "id": "rsi-above-50",
      "description": "RSI 14 above 50 line (momentum confirmation). Focus on 50-line and divergences, NOT OB/OS zones.",
      "indicator": "Relative Strength Index",
      "fields": [
        "RSI"
      ],
      "threshold": 50,
      "weight": 1.0
    },
    {
      "id": "adx-trending",
      "description": "ADX 14 above 25 (confirmed trend). >40 = strong trend. <20 = no trend.",
      "indicator": "Average Directional Index",
      "fields": [
        "ADX"
      ],
      "threshold": 25,
      "weight": 1.0
    },
    {
      "id": "chop-trending",
      "description": "CHOP index from LnL — below 45 = trending. Below 35 = strong trend. Above 55 = choppy/avoid.",
      "indicator": "Locked and Loaded + LossMin v2",
      "fields": [
        "TV_CHOP"
      ],
      "threshold_below": 45,
      "weight": 1.0
    },
    {
      "id": "volume-profile",
      "description": "Trader Dale VP analysis — Session + Visible Range. Buy volume > sell volume = bullish. Check POC, VAH, VAL.",
      "indicator": "Session Volume Profile + Visible Range Volume Profile",
      "fields": [
        "Up",
        "Down",
        "Total"
      ],
      "weight": 0.5
    },
    {
      "id": "atr-sizing",
      "description": "ATR 14 for stop placement and position sizing. Min 10% of daily ATR per Trader Dale rules.",
      "indicator": "Average True Range",
      "fields": [
        "ATR"
      ],
      "weight": 0
    }
  ],
  "risk_rules": [
    {
      "id": "max-risk-1pct",
      "description": "Never risk more than 1% of account per trade",
      "type": "display_only"
    },
    {
      "id": "no-final-30min",
      "description": "No entries in final 30 minutes of session",
      "type": "display_only"
    },
    {
      "id": "vix-check",
      "description": "Skip all entries if VIX > 25",
      "type": "display_only"
    },
    {
      "id": "news-check",
      "description": "Always check news/catalysts manually before entry",
      "type": "display_only"
    },
    {
      "id": "atr-stops",
      "description": "ATR 14 Daily for stop placement and position sizing",
      "type": "display_only"
    },
    {
      "id": "tier-sizing",
      "description": "Tier 1 (4-5 confluences) = full size | Tier 2 (3) = watch only | Tier 3 (<3) = ignore",
      "type": "display_only"
    }
  ],
  "scanner_script": "~/ibkrbot/bin/morning_brief_scanner.js",
  "scanner_usage": "node ~/ibkrbot/bin/morning_brief_scanner.js 45  OR  node ~/ibkrbot/bin/morning_brief_scanner.js 30,45,60,240",
  "required_chart_indicators": [
    "3DXE ULTIMATE b015",
    "Locked and Loaded + LossMin v2 (LnL)",
    "CTTV TTM v6",
    "Session Volume Profile",
    "Visible Range Volume Profile",
    "Relative Strength Index (14)",
    "Average True Range (14)",
    "Average Directional Index (14)"
  ],
  "grading": {
    "scale": "A+ through C-",
    "top_n": 15,
    "a_tier": "Full confluence — Armed+Breakout+BullTakeoff, RSI>55, ADX>25, CHOP<45",
    "b_tier": "Partial — Armed+Breakout OR strong RSI/ADX, incomplete alignment",
    "c_tier": "Early watch — one or two signals only, included for tracking"
  },
  "session_notes": "Morning Brief system — Canadian small/mid-cap stocks (TSX, TSXV, CSE). Uses 7 indicators: 3DXE, LnL, CTTV v6, VP (Trader Dale), RSI, ATR, ADX. Grade top 15 A+ through C-. RSI focus is on the 50 line and divergences, NOT OB/OS zones. For short bias: invert all conditions. First week: compare TF 30/45/60/240 to find optimal timeframe.\n\n2026-08-18: REMOVED TSXV:ODV and TSXV:GGA. Both stopped printing in late July (ODV.V last 2026-07-27, GGA.V last 2026-07-29) and neither has a live Canadian listing: TradingView symbol search returns NO TSX/TSXV line for either (ODV -> Invesco NASDAQ funds only; GGA -> Grupo Galicia / Getchell Gold on German venues only), and yfinance shows no .TO listing at all. TradingView could not resolve them, so setSymbol silently landed on a DIFFERENT security every scan: TSXV:ODV -> TSXV:OGG and TSXV:GGA -> TSXV:GORO, deterministically, on all 4 timeframes. Before the 2026-08-16 symbol-echo guard those wrong prices were written into their rows as data; after it they became error rows (2 tickers x 3 retries x 4 TFs = the 24 'stale reads' on 08-17). ⛔ NOT a prefix fix — TSX:ODV does not exist either; re-prefixing would swap one unresolvable symbol for another. If either was acquired or renamed, add the SUCCESSOR ticker rather than restoring these."
}